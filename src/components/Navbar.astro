---
import { nav } from "@data/nav"
---
<nav class="navbar bg-paper border-b border-charcoal/10">
  <div class="flex-1">
      <a href="/" class="p-2 hover:opacity-80 transition-opacity flex gap-4 items-center">
          <img src="/images/logo-wide.png"
               width="211" height="80" alt="Left Join Studio"
               class="w-[8em]">
      </a>
  </div>
  <div class="flex-none">
    <ul class="menu menu-horizontal p-0 hidden sm:flex gap-1">
      {nav.map(item => (
        <li>
          <a href={item.slug} class="text-charcoal hover:text-signal font-medium transition-colors">{item.title}</a>
        </li>
      ))}
    </ul>
    <div class="dropdown dropdown-end sm:hidden">
      <label tabindex={0} class="btn btn-ghost btn-square">
        <svg class="w-6 h-6 text-charcoal" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </label>
      <ul tabindex={0} class="dropdown-content menu p-2 bg-paper border border-charcoal/10 rounded-lg z-10 w-52 shadow-lg">
        {nav.map(item => (
          <li>
            <a href={item.slug} class="text-charcoal hover:text-signal">{item.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>
