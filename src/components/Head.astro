---
const siteInfo = {
  siteName: 'Left Join Studio',
  siteDesc: 'Rapid prototyping and data solutions. We validate ideas and deliver working prototypes faster than traditional consulting.',
}

let {title} = Astro.props;
let {desc} = Astro.props;
let {img} = Astro.props;
let {twitterUsername} = Astro.props;

if(!title) {
  title = siteInfo.siteName
}
if(!desc) {
  desc = siteInfo.siteDesc
}
if(!img) {
  img = Astro.site+'card.png'
}
// Each page shares as itself, not as the home page
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
---

<head>
  
	<!-- essential -->
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<link rel="icon" href="/favicon.ico" sizes="any" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  
  <!-- core -->
	{title && <title>{title}</title>}
	{desc && <meta name="description" content={desc}>}
	<!-- twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	{title && <meta name="twitter:title" content={title} />}
	{desc && <meta name="twitter:description" content={desc} />}
	<meta name="twitter:image" content={img} />
	{title && <meta name="twitter:image:alt" content={title} />}
	{twitterUsername && <meta name="twitter:site" content={twitterUsername}/>}
	{twitterUsername && <meta name="twitter:creator" content={twitterUsername}/>}
	<!-- og -->
	{title && <meta property="og:title" content={title} />}
	{desc && <meta property="og:description" content={desc} />}
	<meta property="og:image" content={img} />
	{title && <meta property="og:image:alt" content={title} />}
	<meta property="og:site_name" content={siteInfo.siteName} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={pageUrl} />
	<link rel="canonical" href={pageUrl} />
	<slot/>
</head>
