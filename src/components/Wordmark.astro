---
// Set in type instead of the 211px PNG, so it stays sharp on a booth monitor.
const { dark = false } = Astro.props;
---
<span class="inline-flex items-baseline font-sans leading-none select-none" aria-label="Left Join Studio">
  <span class:list={["font-bold tracking-tight text-[19px]", dark ? "text-paper" : "text-charcoal"]} aria-hidden="true">LEFT<span class="text-signal">JOIN</span></span>
  <span class:list={["font-normal text-[19px] ml-[5px] tracking-tight", dark ? "text-term-muted" : "text-pencil"]} aria-hidden="true">studio</span>
</span>
