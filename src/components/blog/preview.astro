---
import type { Post } from '@data/post';
const post: Post = Astro.props.post
---

<div class="bg-whiteboard rounded-lg overflow-hidden hover:shadow-md transition-shadow">
	{post.img &&
		<a href={`/${post.slug}`} class="block">
			<img src={post.img} alt={post.title} width="400" height="200" class="w-full h-40 object-cover" />
		</a>
	}
	<div class="p-4">
		<h3 class="text-lg font-semibold text-charcoal mb-2">
			<a class="hover:text-signal transition-colors" href={`/${post.slug}`}>{post.title}</a>
		</h3>
		<p class="text-pencil text-sm line-clamp-2">{post.desc}</p>
	</div>
</div>
