---
import { objections } from "@data/company"
const { id = "questions" } = Astro.props;
---
<section id={id} class="bg-whiteboard border-y border-charcoal/10">
  <div class="wrap section">
    <div class="grid gap-8 md:grid-cols-12 mb-12 md:mb-16">
      <div class="md:col-span-7 reveal">
        <p class="eyebrow mb-4">Fair questions</p>
        <h2 class="h2">You just met us. Ask the hard ones.</h2>
      </div>
      <p class="lead md:col-span-5 md:pt-10 reveal">These are the questions we'd ask about a company we met at a booth. Here are the answers, in writing, before you spend a minute on a call.</p>
    </div>
    <div class="panel-grid md:grid-cols-2">
      {objections.map((o) => (
        <div class="p-7 md:p-9 reveal">
          <h3 class="h3 mb-3">{o.q}</h3>
          <p class="text-pencil">{o.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
