---
import { company } from "@data/company"
import { products, jesse } from "@data/products"
import Wordmark from "@components/Wordmark";
---
<footer class="on-dark w-full bg-term text-term-muted border-t border-term-line">
  <div class="wrap py-16 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <Wordmark dark />
      <p class="mt-5 max-w-sm text-[15px]">AI that does real work, from a studio that has shipped production software since {company.since}.</p>
      <address class="not-italic mt-6 font-mono text-[13px] leading-relaxed">
        {company.legal}<br/>
        {company.street}<br/>
        {company.city}<br/>
        <a href={company.phoneHref} class="text-term-text hover:text-signal">{company.phone}</a>
      </address>
    </div>
    <div class="md:col-span-2">
      <p class="eyebrow mb-4">Products</p>
      <ul class="space-y-2 text-[15px]">
        {products.map(p => <li><a href={`/products#${p.slug}`} class="hover:text-paper">{p.name}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="eyebrow mb-4">Company</p>
      <ul class="space-y-2 text-[15px]">
        <li><a href="/about" class="hover:text-paper">About</a></li>
        <li><a href="/services" class="hover:text-paper">Services</a></li>
        <li><a href="/training" class="hover:text-paper">Training</a></li>
        <li><a href="/news" class="hover:text-paper">Writing</a></li>
        <li><a href="/about#questions" class="hover:text-paper">Fair questions</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow mb-4">Get_started</p>
      <ul class="space-y-2 text-[15px]">
        <li><a href={jesse.phoneHref} class="text-term-text hover:text-signal">Call Jesse {jesse.phone}</a></li>
        <li><a href="/contact" class="hover:text-paper">Book a free first call</a></li>
        <li><a href="/privacy" class="hover:text-paper">Privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-term-line">
    <div class="wrap py-6 flex flex-col sm:flex-row gap-2 justify-between font-mono text-[12px]">
      <span>&copy; {(new Date()).getFullYear()} {company.legal} All rights reserved.</span>
      <span><span class="text-signal">$</span> shipping since {company.since}<span class="cursor !h-[12px] !w-[6px]"></span></span>
    </div>
  </div>
</footer>
