---
import Page from "@layouts/page";
const {title} = Astro.props;
const {desc} = Astro.props;
const {img} = Astro.props;
---
<Page title={title} desc={desc} img={img}>
    <div class="prose prose-headings:text-charcoal prose-p:text-pencil prose-strong:text-charcoal prose-li:text-pencil md:prose-md lg:prose-lg mx-auto p-6 md:max-w-3xl [&_a:not(.btn)]:text-signal [&_.btn]:no-underline">
        <slot />
    </div>
</Page>
