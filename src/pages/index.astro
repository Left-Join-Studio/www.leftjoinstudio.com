---
import { published } from "@data/post"
import Layout from "@layouts/page";
import Preview from "@components/blog/preview";

const markdownFiles = await Astro.glob('../content/**/*.md')
const posts = published(markdownFiles).slice(0, 3);
---
<Layout title="Left Join Studio - Rapid Prototyping & Data Solutions" desc="We transform ideas into validated prototypes faster than traditional consulting. Value-driven solutions for data products and automation.">
	<!-- Hero Section -->
	<section class="px-6 py-16 md:py-24">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl md:text-5xl font-bold text-charcoal leading-tight mb-6">
				Ideas validated<span class="text-signal">.</span><br/>
				Prototypes delivered<span class="text-signal">.</span>
			</h1>
			<p class="text-xl text-pencil mb-8 max-w-2xl mx-auto">
				We build working prototypes that prove concepts before you commit to full development.
				Value-driven consulting that respects your time and budget.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact" class="btn btn-primary px-8">Start a Conversation</a>
				<a href="/services" class="btn btn-outline border-charcoal text-charcoal hover:bg-charcoal hover:text-paper px-8">View Services</a>
			</div>
		</div>
	</section>

	<!-- Value Props -->
	<section class="px-6 py-16 bg-whiteboard">
		<div class="max-w-4xl mx-auto">
			<h2 class="text-2xl md:text-3xl font-semibold text-charcoal text-center mb-12">
				Why Left Join Studio<span class="text-signal">?</span>
			</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="w-12 h-12 bg-signal/10 rounded-lg flex items-center justify-center mx-auto mb-4">
						<svg class="w-6 h-6 text-signal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</div>
					<h3 class="font-semibold text-charcoal mb-2">Rapid Validation</h3>
					<p class="text-pencil text-sm">Working prototypes in days, not months. Validate ideas before committing resources.</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-signal/10 rounded-lg flex items-center justify-center mx-auto mb-4">
						<svg class="w-6 h-6 text-signal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h3 class="font-semibold text-charcoal mb-2">Value-Based Pricing</h3>
					<p class="text-pencil text-sm">Pay for results, not hours. Transparent pricing tied to deliverables.</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-signal/10 rounded-lg flex items-center justify-center mx-auto mb-4">
						<svg class="w-6 h-6 text-signal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</div>
					<h3 class="font-semibold text-charcoal mb-2">25+ Years Experience</h3>
					<p class="text-pencil text-sm">Deep expertise in data products, automation, and rapid development.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Overview -->
	<section class="px-6 py-16">
		<div class="max-w-4xl mx-auto">
			<h2 class="text-2xl md:text-3xl font-semibold text-charcoal text-center mb-12">
				What We Do
			</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<div class="border-2 border-charcoal/10 rounded-lg p-6 hover:border-signal/30 transition-colors">
					<h3 class="font-semibold text-charcoal mb-2">Project Discovery</h3>
					<p class="text-pencil text-sm mb-4">Strategic roadmaps, scope planning, and challenge identification before development begins.</p>
					<a href="/services" class="text-signal text-sm font-medium hover:underline">Learn more &rarr;</a>
				</div>
				<div class="border-2 border-charcoal/10 rounded-lg p-6 hover:border-signal/30 transition-colors">
					<h3 class="font-semibold text-charcoal mb-2">Rapid Prototyping</h3>
					<p class="text-pencil text-sm mb-4">Working prototypes with core functionality to validate technical feasibility and stakeholder buy-in.</p>
					<a href="/services" class="text-signal text-sm font-medium hover:underline">Learn more &rarr;</a>
				</div>
				<div class="border-2 border-charcoal/10 rounded-lg p-6 hover:border-signal/30 transition-colors">
					<h3 class="font-semibold text-charcoal mb-2">Automation Solutions</h3>
					<p class="text-pencil text-sm mb-4">Custom automation to streamline operations, reduce manual work, and improve efficiency.</p>
					<a href="/services" class="text-signal text-sm font-medium hover:underline">Learn more &rarr;</a>
				</div>
				<div class="border-2 border-charcoal/10 rounded-lg p-6 hover:border-signal/30 transition-colors">
					<h3 class="font-semibold text-charcoal mb-2">Training & Workshops</h3>
					<p class="text-pencil text-sm mb-4">Hands-on training in data automation, AI tools, and modern development practices.</p>
					<a href="/training" class="text-signal text-sm font-medium hover:underline">View packages &rarr;</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Latest News -->
	{posts.length > 0 && (
		<section class="px-6 py-16 bg-whiteboard">
			<div class="max-w-4xl mx-auto">
				<div class="flex justify-between items-center mb-8">
					<h2 class="text-2xl md:text-3xl font-semibold text-charcoal">
						Latest News
					</h2>
					<a href="/news" class="text-signal font-medium hover:underline">View all &rarr;</a>
				</div>
				<div class="grid md:grid-cols-3 gap-6">
					{posts.map((p) => <Preview post={p} />)}
				</div>
			</div>
		</section>
	)}

	<!-- CTA Section -->
	<section class="px-6 py-16">
		<div class="max-w-2xl mx-auto text-center">
			<h2 class="text-2xl md:text-3xl font-semibold text-charcoal mb-4">
				Ready to validate your idea<span class="text-signal">?</span>
			</h2>
			<p class="text-pencil mb-8">
				Let's discuss how we can help you move from concept to working prototype.
			</p>
			<a href="/contact" class="btn btn-primary px-8">Get in Touch</a>
		</div>
	</section>
</Layout>
