---
import Page from "@layouts/page";
import PageHero from "@components/PageHero";
import CtaBand from "@components/sections/CtaBand";

const packages = [
	{
		name: 'Power Hour',
		price: '$499',
		unit: 'one session',
		body: 'A one-hour session to get your bearings on AI and data automation. You leave with a clear plan for what to do next.',
		points: ['We find out what you\'re after', 'An example project built with your data', 'Clear next steps'],
		featured: false,
	},
	{
		name: 'Let\'s Go',
		price: '$1,999',
		unit: 'eight sessions',
		body: 'Eight in-depth sessions with hands-on project work between them. You build real tools and finish able to take on the next one alone.',
		points: ['Everything in Power Hour', 'A project that matters to your business', 'A finished, working solution', 'A second round on a new problem'],
		featured: true,
	},
]
---
<Page title="Training - Left Join Studio" desc="Hands-on AI and data automation training from Left Join Studio. One session or eight, using your own data, at a posted price.">
	<PageHero label="Training" title="Learn it on your own data, from someone who does it for a living." lead="Sessions are one-on-one or with your team, shaped to what your business is trying to get done. The price is the price." />

	<section class="bg-paper">
		<div class="wrap section">
			<div class="grid md:grid-cols-2 gap-6">
				{packages.map(p => (
					<div class:list={["p-8 md:p-10 flex flex-col reveal", p.featured ? "on-dark bg-ink text-paper rounded-[18px] shadow-[0_24px_48px_-24px_rgba(31,27,24,0.6)]" : "panel"]}>
						<div class="flex items-center justify-between gap-4">
							<h2 class="font-bold tracking-tight text-[30px] leading-none">{p.name}</h2>
							{p.featured && <span class="inline-block bg-signal text-ink font-semibold text-[13px] rounded-full px-3 py-1.5 whitespace-nowrap">Most thorough</span>}
						</div>
						<p class:list={["mt-5", p.featured ? "text-ink-muted" : "text-pencil"]}>{p.body}</p>
						<p class="mt-8 flex items-baseline gap-3">
							<span class="font-display font-extrabold text-[48px] leading-none tracking-tight">{p.price}</span>
							<span class:list={["text-[15px] font-medium", p.featured ? "text-ink-muted" : "text-pencil"]}>{p.unit}</span>
						</p>
						<ul class="mt-8 space-y-3 text-[15px] flex-grow">
							{p.points.map(pt => (
								<li class="flex gap-3"><span class="tick" aria-hidden="true"></span><span>{pt}</span></li>
							))}
						</ul>
						<a href="/contact" class:list={["cta mt-10", p.featured ? "cta-primary" : "cta-ghost"]}>Start learning <span class="arrow">&rarr;</span></a>
					</div>
				))}
			</div>
			<p class="mt-8 text-pencil max-w-2xl reveal">Each project builds on the last one, so by the end you're ready for the next data problem without us.</p>
		</div>
	</section>

	<CtaBand title="Not sure which one fits?" body="Tell us what your team is trying to do. We'll say which package makes sense, or whether you need training at all." />
</Page>
