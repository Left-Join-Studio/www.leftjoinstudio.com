---
import Page from "@layouts/page";
import Check from "@components/utilities/Check";
---

<Page title="Training - Left Join Studio" desc="Personalized training sessions in data automation, AI tools, and modern development practices.">
<section class="px-6 py-12">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
            <h1 class="text-3xl md:text-4xl font-bold text-charcoal mb-4">Training Packages</h1>
            <p class="text-pencil max-w-2xl mx-auto">
                Personalized training sessions tailored to meet your specific business objectives in data automation, storage, and analysis.
                Our expert guidance covers all major programming languages and data tools.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <!-- Power Hour -->
            <div class="border-2 border-charcoal/10 rounded-xl p-8 hover:border-signal/30 transition-colors">
                <h3 class="text-2xl font-semibold text-charcoal mb-4">Power Hour</h3>
                <p class="text-pencil mb-6">
                    A one-hour session to kickstart your understanding of AI and data automation.
                    Leave with a clear roadmap for success.
                </p>
                <div class="mb-6">
                    <span class="line-through text-pencil/70 text-lg">$1000</span>
                    <span class="text-4xl font-bold text-charcoal ml-2">$499</span>
                </div>
                <a href="/contact"
                   class="btn btn-outline border-charcoal text-charcoal hover:bg-charcoal hover:text-paper w-full mb-6">
                    Start Learning
                </a>
                <ul class="space-y-3 text-pencil">
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Discover your goals</span>
                    </li>
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Example project with your data</span>
                    </li>
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Clear next steps</span>
                    </li>
                </ul>
            </div>

            <!-- LET'S GO -->
            <div class="border-2 border-signal rounded-xl p-8 bg-signal/5">
                <h3 class="text-2xl font-semibold text-signal mb-4">LET'S GO</h3>
                <p class="text-pencil mb-6">
                    An immersive program of eight in-depth sessions and hands-on project work.
                    Build real tools and gain confidence to tackle complex challenges.
                </p>
                <div class="mb-6">
                    <span class="line-through text-pencil/70 text-lg">$4,000</span>
                    <span class="text-4xl font-bold text-charcoal ml-2">$1,999</span>
                </div>
                <a href="/contact"
                   class="btn btn-primary w-full mb-6">
                    Start Learning
                </a>
                <ul class="space-y-3 text-pencil">
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Everything in Power Hour, plus...</span>
                    </li>
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Start a relevant project</span>
                    </li>
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Complete a working solution</span>
                    </li>
                    <li class="flex gap-3 items-start">
                        <Check /> <span>Repeat with new challenges</span>
                    </li>
                </ul>
            </div>
        </div>

        <p class="text-center text-pencil mt-8">
            Each project iteration builds on the last, ensuring you're ready to tackle any data challenge.
        </p>
    </div>
</section>
</Page>
