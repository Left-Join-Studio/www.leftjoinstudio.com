---
import Layout from "@layouts/page";
---
<Layout title="Page not found - Left Join Studio">
	<section class="bg-whiteboard">
		<div class="wrap py-28 md:py-40">
			<p class="eyebrow mb-4">Page not found</p>
			<h1 class="h2 max-w-2xl">That page isn't here.</h1>
			<p class="lead mt-6 max-w-xl">The link is old or mistyped. Everything we make is one click from the home page.</p>
			<div class="mt-10 flex flex-col sm:flex-row gap-3">
				<a href="/" class="cta cta-primary">Go home <span class="arrow">&rarr;</span></a>
				<a href="/products" class="cta cta-ghost">See the products</a>
			</div>
		</div>
	</section>
</Layout>
