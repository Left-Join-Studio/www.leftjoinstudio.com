---
import Layout from "@layouts/prose";
import Date from "@components/utilities/Date";
import { published, getRSS } from "@data/post"

export async function getStaticPaths({ rss }) {
	const markdownFiles = await Astro.glob('../content/**/*.md');
	const posts = published( markdownFiles );
	
	return posts.map((post) => {
		return {
			params: { post: post.slug },
			props: { post }
		};
	})
}

// Destructure to get both `Astro.props.post` and `Astro.props.post.Content`
const { post: { Content }, post } = Astro.props;
---
<Layout title={post.title} desc={post.desc} img={post.img ? post.img : null}>
	<p class="not-prose mb-8"><a href="/news" class="font-mono text-[12px] uppercase tracking-wider text-pencil hover:text-signal-ink">&larr; Writing</a></p>
	<h1>{post.title}</h1>
	<p class="not-prose font-mono text-[12px] uppercase tracking-wider text-pencil -mt-4 mb-10">
		<Date date={post.date}/>{post.author && <span> &middot; {post.author}</span>}
	</p>
	{post.img &&
		<figure>
			<img src={post.img} alt="" width={post.imgWidth} height={post.imgHeight} />
		</figure>
	}
	<Content />
</Layout>
