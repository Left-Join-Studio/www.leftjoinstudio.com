---
import { products, jesse } from "@data/products"
import Layout from "@layouts/page";
import PageHero from "@components/PageHero";
import CtaBand from "@components/sections/CtaBand";

const groups = [
	{ tier: 'flagship', label: 'For_the_trades', title: 'The one that answers your phone.' },
	{ tier: 'business', label: 'For_the_office', title: 'Tools that take work off someone\'s desk.' },
	{ tier: 'builder', label: 'For_people_who_build', title: 'What we use to run our own AI agents.' },
].map(g => ({ ...g, items: products.filter(p => p.tier === g.tier) })).filter(g => g.items.length > 0)
---
<Layout title="Products - Left Join Studio" desc="Every Left Join Studio product is live. Call Jesse, the AI receptionist for the trades, or try the tools we build for sales teams, executives and developers.">
	<PageHero label="Products" title="Every product here is live. Go use one." lead="We'd rather you spend two minutes with the software than twenty reading about it. Each of these runs in production today.">
		<div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 font-mono text-[13px]">
			{products.map(p => (
				<a href={`#${p.slug}`} class="text-term-text hover:text-signal transition-colors flex items-center gap-2"><span class="dot-live"></span>{p.name}</a>
			))}
		</div>
	</PageHero>

	{groups.map((g, gi) => (
		<section class:list={[gi % 2 === 0 ? "bg-paper" : "bg-whiteboard border-y border-charcoal/10"]}>
			<div class="wrap section">
				<div class="mb-12 reveal">
					<p class="eyebrow mb-5">{g.label}</p>
					<h2 class="h2 max-w-3xl">{g.title}</h2>
				</div>
				<div class="space-y-6">
					{g.items.map(p => (
						<article id={p.slug} class="border border-charcoal/15 bg-paper grid lg:grid-cols-12 reveal">
							<div class="lg:col-span-7 p-7 md:p-10">
								<div class="flex flex-wrap items-center gap-2 mb-5">
									<span class="chip"><span class="dot-live"></span> Live</span>
									<span class="chip">{p.kind}</span>
									<span class="chip">{p.audience}</span>
								</div>
								<h3 class="font-bold tracking-tight text-[clamp(30px,3.4vw,44px)] leading-none">{p.name}<span class="text-signal">.</span></h3>
								<p class="mt-4 text-[20px] font-semibold tracking-tight">{p.line}</p>
								<p class="mt-3 text-pencil max-w-xl">{p.body}</p>
								<div class="mt-8 flex flex-col sm:flex-row gap-3">
									{p.slug === 'jesse' && <a href={jesse.phoneHref} class="cta cta-primary plausible-event-name=Call+Jesse plausible-event-where=products">Call Jesse {jesse.phone}</a>}
									<a href={p.url} class:list={["cta", p.slug === 'jesse' ? "cta-ghost" : "cta-primary"]}>{p.slug === 'jesse' ? 'Get a free month' : p.cta} <span class="arrow">&rarr;</span></a>
								</div>
							</div>
							<div class="lg:col-span-5 border-t lg:border-t-0 lg:border-l border-charcoal/15 bg-whiteboard p-7 md:p-10 flex flex-col justify-between gap-8">
								<ul class="space-y-4 text-[15px]">
									{p.points.map(pt => (
										<li class="flex gap-3"><span class="font-mono text-signal shrink-0" aria-hidden="true">+</span><span>{pt}</span></li>
									))}
								</ul>
								<p class="font-mono text-[12px] text-pencil break-all"><span class="text-signal">$</span> open {p.host}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	))}

	<section class="bg-paper border-t border-charcoal/10">
		<div class="wrap py-16 md:py-20 grid gap-8 md:grid-cols-12 md:items-center">
			<div class="md:col-span-8 reveal">
				<p class="eyebrow mb-5">Not_on_the_list</p>
				<h2 class="h3 !text-[28px]">Need one of these shaped to your business, or something that isn't here?</h2>
				<p class="text-pencil mt-3 max-w-2xl">Every product above started as a job somebody couldn't keep up with. We build custom tools the same way, for a fixed price, and you keep the code.</p>
			</div>
			<div class="md:col-span-4 md:text-right reveal">
				<a href="/services" class="cta cta-ghost">See how we work <span class="arrow">&rarr;</span></a>
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>
