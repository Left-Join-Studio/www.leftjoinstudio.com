---
import { published } from "@data/post"
import Layout from "@layouts/page";
import PageHero from "@components/PageHero";
import Preview from "@components/blog/preview";

const markdownFiles = await Astro.glob('../content/**/*.md')
const posts = published(markdownFiles);
---
<Layout title="Writing - Left Join Studio" desc="How Left Join Studio thinks about prototypes, pricing and building software that gets used.">
	<PageHero label="Writing" title="How we think." lead="Notes on prototypes, pricing, and building software that gets used." />
	<section class="bg-paper">
		<div class="wrap section">
			<div class="panel-grid md:grid-cols-2">
				{posts.map((p) => <Preview post={p} />)}
			</div>
		</div>
	</section>
</Layout>
