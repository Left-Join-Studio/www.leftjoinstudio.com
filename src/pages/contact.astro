---
import { company } from "@data/company"
import { jesse } from "@data/products"
import Layout from "@layouts/page";
import PageHero from "@components/PageHero";
import ContactForm from "@components/utilities/ContactForm";

const next = [
	'A person reads it and writes back.',
	'We set up a thirty-minute call. It\'s free, and there are no slides.',
	'You get a straight answer on that call: build it, don\'t, or try something cheaper first.',
]
---
<Layout title="Contact - Left Join Studio" desc="Tell Left Join Studio about the job. The first call is free, and you'll get a straight answer on whether it's worth building.">
	<PageHero label="Contact" title="Tell us about the job." lead="The first call is free. You'll leave it knowing whether the thing is worth building and what it would cost." />

	<section class="bg-paper">
		<div class="wrap section grid gap-14 lg:grid-cols-12">
			<div class="lg:col-span-7">
				<ContactForm />
			</div>
			<aside class="lg:col-span-5 space-y-6">
				<div class="border border-charcoal/15">
					<p class="eyebrow px-6 py-4 border-b border-charcoal/15 bg-whiteboard">What_happens_next</p>
					<ol class="px-6 py-2">
						{next.map((n, i) => (
							<li class="flex gap-4 py-4 border-b border-charcoal/10 last:border-b-0">
								<span class="font-mono text-[13px] text-signal-ink pt-0.5">{String(i + 1).padStart(2, '0')}</span>
								<span class="text-[15px]">{n}</span>
							</li>
						))}
					</ol>
				</div>
				<div class="on-dark bg-term text-paper p-6">
					<p class="eyebrow mb-3">Here_about_Jesse</p>
					<p class="text-term-muted text-[15px]">Skip the form. Jesse is on the line now and will show you what your customers would hear.</p>
					<a href={jesse.phoneHref} class="cta cta-primary mt-5 w-full plausible-event-name=Call+Jesse plausible-event-where=contact">Call Jesse {jesse.phone}</a>
				</div>
				<div class="border border-charcoal/15 p-6">
					<p class="eyebrow mb-3">Corporate</p>
					<address class="not-italic font-mono text-[14px] leading-relaxed">
						{company.legal}<br/>
						{company.street}<br/>
						{company.city}<br/>
						{company.country}<br/>
						<a href={company.phoneHref} class="link">{company.phone}</a>
					</address>
				</div>
			</aside>
		</div>
	</section>
</Layout>
